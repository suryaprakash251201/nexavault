{
  "name": "nexavault",
  "version": "1.0.0",
  "description": "Obsidian Vault Sync & Backup Plugin - GitHub live sync, S3-compatible backup, incremental synchronization, conflict resolution",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "sync",
    "backup",
    "github",
    "s3",
    "encryption"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "eslint-plugin-import": "^2.29.0",
    "obsidian": "latest",
    "prettier": "^3.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.470.0",
    "@aws-sdk/credential-providers": "^3.470.0",
    "@aws-sdk/lib-storage": "^3.470.0",
    "@octokit/rest": "^20.0.2",
    "argon2": "^0.31.2",
    "fast-xml-parser": "^4.3.2",
    "uuid": "^9.0.1"
  }
}
